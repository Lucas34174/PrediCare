# Copier vers .env (jamais commité)
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL
POSTGRES_USER=predicare
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=predicare

N8N_DB_NAME=n8n

# --- Secrets applicatifs
# Générez les clés avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_jwt_secret_0123456789abcdef
PII_ENCRYPTION_KEY=change_me_pii_key_0123456789abcdef
N8N_ENCRYPTION_KEY=change_me_n8n_key_0123456789abcdef

# Version de la clé PII (rotation future). Laisser 1 au premier démarrage.
PII_KEY_VERSION=1

# --- Chargement automatique des données (PB-19)
# Le service init monte ce dossier sur /data/source dans Docker.
SOURCE_DATA_DIR=../CohorteAI_datagen/dataset
AUTO_LOAD_DATA=true
# Passer à true uniquement pour vider et recharger les 12 tables métier.
FORCE_RELOAD=false

# --- Configuration métier & MLOps
# Seuil d'anomalie de fraude par défaut (modifiable en direct via PUT /admin/config)
ALERT_THRESHOLD=0.5
FRAUD_SCORE_THRESHOLD=0.5

# Webhook n8n pour les alertes de fraude (contrats §4, modifiable en direct via PUT /admin/config)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/fraud-alert
DASHBOARD_BASE_URL=http://localhost:3000

# Cache sémantique vectoriel (modifiable en direct via PUT /admin/config)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.85

# Canal Email (SMTP Gmail ou local)
ALERT_EMAIL_TO=gestionnaire@predicare.mg
SMTP_FROM=alerte-fraude@predicare.mg

# --- RAG / Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
# GPU : -1 = toutes les couches sur GPU (NVIDIA CUDA), 0 = CPU uniquement.
# Nécessite nvidia-container-toolkit installé sur l'hôte Docker.
OLLAMA_NUM_GPU=-1
# Modèle LLM pour la génération RAG
LLM_MODEL=qwen2.5:7b