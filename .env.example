# Copier vers .env (jamais commité)
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL
POSTGRES_USER=predicare
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=predicare

N8N_DB_NAME=n8n

# --- Secrets applicatifs
# Générez les clés avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_jwt_secret_0123456789abcdef
PII_ENCRYPTION_KEY=change_me_pii_key_0123456789abcdef
N8N_ENCRYPTION_KEY=change_me_n8n_key_0123456789abcdef

# Version de la clé PII (rotation future). Laisser 1 au premier démarrage.
PII_KEY_VERSION=1

# --- Chargement automatique des données (PB-19)
# Le service init monte ce dossier sur /data/source dans Docker.
SOURCE_DATA_DIR=../CohorteAI_datagen/dataset
AUTO_LOAD_DATA=true
# Passer à true uniquement pour vider et recharger les 12 tables métier.
FORCE_RELOAD=false

# --- Configuration métier
ALERT_THRESHOLD=0.5
N8N_WEBHOOK_URL=http://n8n:5678/webhook/claim-alert

# --- LLM de l'assistant (interface unique, fournisseur choisi ici)
LLM_PROVIDER=ollama
LLM_API_KEY=

# --- Ports exposés sur la machine
DB_PORT=5432
API_PORT=8000
FRONT_PORT=3000
N8N_PORT=5678
N8N_PUBLIC_URL=http://localhost:5678/
TZ=Indian/Antananarivo

# --- RAG / Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024