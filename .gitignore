# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environnements virtuels
.venv/
venv/
ENV/
env/

# Tests & Qualité de code
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb

# Configuration & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Packaging & Distribution
*.egg-info/
build/
dist/
*.egg

# Logs & Bases locales
*.log
logs/
*.sqlite3
*.sqlite
*.db

# Données : jamais dans Git (PII synthétiques + volumétrie)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
agent-ressources/*

# Artefacts de modèles volumineux (à versionner via registre/volume/DVC/MLflow)
models/*
!models/.gitkeep
*.pkl
*.joblib
*.onnx
*.pt
*.pth
*.safetensors
web/.agents
web/@
# Interface Web / Node (si applicable dans /web)
node_modules/
.streamlit/secrets.toml

# IDEs et Systèmes d'exploitation
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db

